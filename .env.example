# Copy this file to .env before setting local-only options.
# Leave DATABASE_URL unset to use the local SQLite databases in data/.
# DATABASE_URL=postgresql://traffic_app:YOUR_PASSWORD@localhost:5432/traffic_safety
# Run scripts/configure_postgres.py to create a local PostgreSQL app role/database and set DATABASE_URL in .env.
# Example format: postgresql://traffic_app:password@localhost:5432/traffic_safety
# Leave DATABASE_URL unset to use local SQLite.
SQLITE_DATABASE_DIR=data
YOLO_MODEL_PATH=assets/models/yolov8n.onnx
DASHBOARD_UI_URL=http://127.0.0.1:8080
DASHBOARD_API_INTERFACE_URL=http://127.0.0.1:8081
